# Copy to backend/.env. Every key is optional; defaults live in app/config.py.

# --- Datalag ---------------------------------------------------------------
# PostgreSQL/PostGIS target schema (used by Alembic; see app/datalag).
DATABASE_URL=postgresql://saferoute:saferoute@localhost:5432/saferoute
# Dev-time SQLite stores (users, reports, news archive). Default: backend/data
# DATA_DIR=./data

# --- Backend API -----------------------------------------------------------
# Signs session tokens. MUST be a long random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-secret-change-me
# Confirmations before a report counts as verified (F3) and triggers rescoring (NF5)
REPORT_VERIFICATION_THRESHOLD=3
# Anti-spam (NF10): max reports per user per rolling window
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MINUTES=60

# --- Rutemotor (OSRM) --------------------------------------------------------
# Public OSM foot-routing demo instance: fine for local dev, not for production load.
# Self-hosted (infrastructure/osrm/README.md): http://localhost:5000
OSRM_SERVER_URL=https://routing.openstreetmap.de/routed-foot

# --- Async Worker ------------------------------------------------------------
# background (in-process, launch variant, default) | celery (needs Redis + worker)
ASYNC_WORKER=background
REDIS_URL=redis://localhost:6379/0
# Differential-privacy budget for published scores (NF11)
DP_EPSILON=1.0
