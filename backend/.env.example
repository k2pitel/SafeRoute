DATABASE_URL=postgresql://saferoute:saferoute@localhost:5432/saferoute
REDIS_URL=redis://localhost:6379/0
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# Public OSM foot-routing demo instance — fine for local dev, not for production load.
OSRM_SERVER_URL=https://routing.openstreetmap.de/routed-foot
NEWS_API_KEY=your_news_api_key_here
DP_EPSILON=1.0
# Async Worker realisation: background (in-process, default) | celery (needs Redis + worker)
ASYNC_WORKER=background
# Confirmations before a report counts as verified (F3) and triggers rescoring (NF5)
REPORT_VERIFICATION_THRESHOLD=3
