@startuml SafeRoute_Datalag_ER
scale 1.3
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam titleFontSize 20
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2E6E3E
  HeaderBackgroundColor #2E6E3E
  HeaderFontColor white
}
skinparam package {
  BorderColor #7F8C8D
  FontSize 13
}
hide circle
hide methods

title Datalag: databaseskema, nuværende realisering og målskema

package "Nuværende realisering: SQLite (local_store.db)" {
  entity "users" as su {
    * id : TEXT <<PK>> (UUID)
    --
    * email : TEXT <<UNIQUE>>
    * password_hash : TEXT (salt$pbkdf2)
    * created_at : TEXT (ISO 8601)
  }
  entity "reports" as sr {
    * id : INTEGER <<PK>> AUTOINCREMENT
    --
    * user_id : TEXT
    * type : TEXT
    description : TEXT
    * latitude : REAL
    * longitude : REAL
    * occurred_at : TEXT
    * confirmations : INTEGER = 0
    * created_at : TEXT
  }
}

package "Nuværende realisering: SQLite (news_archive.db)" {
  entity "news_items" as sn {
    * url : TEXT <<PK>>
    --
    * title : TEXT
    * source : TEXT
    * published_at : TEXT
    latitude : REAL
    longitude : REAL
    * archived_at : TEXT
  }
}

package "Målskema: PostgreSQL + PostGIS (alembic 0001)" {
  entity "users" as pu {
    * id : UUID <<PK>>
    --
    risk_profile : VARCHAR(20) = 'balanced'
    emergency_contacts : JSONB
    created_at : TIMESTAMPTZ
  }
  entity "reports" as pr {
    * id : SERIAL <<PK>>
    --
    * user_id : UUID <<FK>>
    * location : GEOGRAPHY(POINT, 4326)
    description : TEXT
    confirmations : INTEGER = 0
    created_at : TIMESTAMPTZ
  }
  entity "incidents" as pi {
    * id : SERIAL <<PK>>
    --
    * type : VARCHAR(50)
    description : TEXT
    * location : GEOGRAPHY(POINT, 4326)
    * occurred_at : TIMESTAMPTZ
    * source : VARCHAR(50)
    verified : BOOLEAN = false
    created_at : TIMESTAMPTZ
  }
  entity "segment_scores" as ps {
    * id : SERIAL <<PK>>
    --
    * segment_id : VARCHAR(64) <<INDEX>>
    * geom : GEOGRAPHY(LINESTRING, 4326)
    * safety_score : NUMERIC(4,2)
    * time_bucket : VARCHAR(20)
    shap_summary : JSONB
    updated_at : TIMESTAMPTZ
  }
}

su ||..o{ sr : "user_id\n(logisk, ingen FK)"
pu ||--o{ pr : "user_id (FK)"
@enduml
